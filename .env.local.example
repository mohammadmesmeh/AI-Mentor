# Base URL of the backend API. Recommended local value per API_CONTRACT.md §1:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Google sign-in (API_CONTRACT.md §7, POST /auth/google): the public Web OAuth
# Client ID from Google Cloud. It must be the same value as the backend's
# GOOGLE_CLIENT_ID, and this site's origins (e.g. http://localhost:3000 and the
# Vercel domain) must be listed under "Authorized JavaScript origins". Not a
# secret; there is no client secret or redirect URI. Empty = the Google button
# says Google sign-in isn't available.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
